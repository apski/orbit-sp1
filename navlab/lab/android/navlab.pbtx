# Perfetto config for NavLab sweeps: lab trace sections (atrace app tags) + scheduler for per-thread CPU.
# Stopped by lab/android/sweep.py (SIGTERM) once the autopilot has exited the app.
buffers { size_kb: 131072 fill_policy: RING_BUFFER }
buffers { size_kb: 8192 fill_policy: RING_BUFFER }
data_sources {
  config {
    name: "linux.ftrace"
    target_buffer: 0
    ftrace_config {
      ftrace_events: "sched/sched_switch"
      ftrace_events: "sched/sched_wakeup"
      ftrace_events: "task/task_newtask"
      ftrace_events: "task/task_rename"
      atrace_categories: "view"
      atrace_categories: "gfx"
      atrace_categories: "am"
      atrace_categories: "dalvik"
      atrace_apps: "com.lab.rnnav"
      atrace_apps: "com.lab.nativenav"
    }
  }
}
data_sources {
  config {
    name: "linux.process_stats"
    target_buffer: 1
    process_stats_config { scan_all_processes_on_start: true }
  }
}
duration_ms: 600000
